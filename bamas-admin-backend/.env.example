# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Firebase ---
# Path to the Firebase service-account JSON key (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). This ONE file
# gives this backend read/write access to the SAME Firestore the customer
# app + admin website already use, and lets it send FCM push notifications.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Admin login (this backend's own auth, separate from Firebase Auth) ---
ADMIN_USERNAME=admin
# Generate this with: python make_admin_password.py "your-real-password"
ADMIN_PASSWORD_HASH=

# --- JWT ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720

# --- CORS ---
# Comma-separated list of origins allowed to call this API. "*" is fine for
# local dev / a Flutter mobile app (mobile apps aren't subject to CORS).
ALLOWED_ORIGINS=*
