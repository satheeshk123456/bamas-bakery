<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for Android 8.0+. The launcher masks this into whatever
     shape the device uses (circle, squircle, rounded square), so the logo
     sits inside the 66% "safe zone" of the foreground layer to avoid being
     clipped. Older Android falls back to mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
